{
  "$defs": {
    "DepartmentRule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "departments",
          "default": "departments",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "default": "departments",
          "title": "Layer",
          "type": "string"
        },
        "catalog": {
          "default": "catalog/departments.yml",
          "title": "Catalog",
          "type": "string"
        },
        "view": {
          "default": "metropolitan",
          "title": "View",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "batch_size": {
          "default": 10,
          "maximum": 101,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "directions": {
          "items": {
            "enum": [
              "name-map",
              "map-name",
              "map-code",
              "name-code",
              "code-name",
              "code-map"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Directions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "references"
      ],
      "title": "DepartmentRule",
      "type": "object"
    },
    "IdentificationRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "minLength": 1,
          "title": "Layer",
          "type": "string"
        },
        "catalog": {
          "minLength": 1,
          "title": "Catalog",
          "type": "string"
        },
        "view": {
          "minLength": 1,
          "title": "View",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "id",
        "layer",
        "catalog",
        "view",
        "references"
      ],
      "title": "IdentificationRule",
      "type": "object"
    },
    "PlaceRule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "places",
          "default": "places",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "catalog": {
          "title": "Catalog",
          "type": "string"
        },
        "theme": {
          "title": "Theme",
          "type": "string"
        },
        "directions": {
          "items": {
            "enum": [
              "name-map",
              "map-name"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Directions",
          "type": "array"
        },
        "exclude_targets": {
          "items": {
            "type": "string"
          },
          "title": "Exclude Targets",
          "type": "array"
        },
        "batch_size": {
          "default": 10,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "id",
        "layer",
        "catalog",
        "theme",
        "references"
      ],
      "title": "PlaceRule",
      "type": "object"
    },
    "RelationRule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "relations",
          "default": "relations",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "catalog": {
          "title": "Catalog",
          "type": "string"
        },
        "related_catalog": {
          "title": "Related Catalog",
          "type": "string"
        },
        "relation": {
          "enum": [
            "region",
            "department",
            "capital",
            "massif",
            "downstream",
            "ocean",
            "coast"
          ],
          "title": "Relation",
          "type": "string"
        },
        "theme": {
          "title": "Theme",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "id",
        "layer",
        "catalog",
        "related_catalog",
        "relation",
        "theme",
        "references"
      ],
      "title": "RelationRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rules": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/IdentificationRule"
          },
          {
            "$ref": "#/$defs/DepartmentRule"
          },
          {
            "$ref": "#/$defs/PlaceRule"
          },
          {
            "$ref": "#/$defs/RelationRule"
          }
        ]
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    }
  },
  "required": [
    "rules"
  ],
  "title": "RuleFile",
  "type": "object"
}
