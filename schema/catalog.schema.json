{
  "$defs": {
    "CatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "explanation_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation Key"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabelPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditorialReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "CatalogEntry",
      "type": "object"
    },
    "EditorialReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "verified",
            "needs-review"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked_on": {
          "format": "date",
          "title": "Checked On",
          "type": "string"
        }
      },
      "required": [
        "status",
        "checked_on"
      ],
      "title": "EditorialReview",
      "type": "object"
    },
    "LabelPosition": {
      "additionalProperties": false,
      "properties": {
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        }
      },
      "required": [
        "lon",
        "lat"
      ],
      "title": "LabelPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "features": {
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      },
      "minItems": 1,
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "features"
  ],
  "title": "CatalogFile",
  "type": "object"
}
